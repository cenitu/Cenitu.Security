@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar" hidden="@isHidden">
        <NavMenu />
    </div>

    <main>



        <div class="top-row px-4">
            <button class="btn btn-primary" @onclick="ToggleNavMenu">
                <span class="navbar-toggler-icon">@hideText</span>
            </button>
            <AuthorizeView>
                <Authorized>
                    <span class="bi bi-person" aria-hidden="true" style="vertical-align:middle"></span>Welcome, @context.User.Identity!.Name
                    <a href="logout"><span class="bi bi-box-arrow-right" aria-hidden="true" style="vertical-align:middle"></span>Logout</a>
                </Authorized>
                <NotAuthorized>
                    <a href="login"><span class="bi bi-pencil-square" aria-hidden="true" style="vertical-align:middle"></span>Login</a>
                    <a href="register"><span class="bi bi-pencil-square" aria-hidden="true" style="vertical-align:middle"></span>Register</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>



        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
@code {
    private bool isHidden;
    private string hideText = "<";
    private void ToggleNavMenu(MouseEventArgs args)
    {
        isHidden = !isHidden;
        if (isHidden)
        {
            hideText = ">";
        }
        else
        {
            hideText = "<";
        }
    }
}