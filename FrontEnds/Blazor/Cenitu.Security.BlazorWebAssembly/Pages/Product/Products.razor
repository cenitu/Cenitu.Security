@page "/products"
@attribute [Authorize(Roles = "Admin, User")]
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime

<div class="container mt-4">
    <div class="card shadow-lg p-4">
        <h3 class="text-primary text-center">Product List</h3>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <SfButton CssClass="e-success" IconCss="e-icons e-plus" @onclick="Add"> Add </SfButton>
                <SfButton CssClass="e-warning" IconCss="e-icons e-edit" @onclick="Update"> Update </SfButton>
            </div>
            <div>
                <SfButton CssClass="e-primary e-icon-btn" IconCss="e-icons e-export-excel" @onclick="ExportToExcel">
                    <span class="ml-2">Export to Excel</span>
                </SfButton>
            </div>
        </div>
        <SfGrid ID="Grid"
                @ref="DefaultGrid"
                TValue="ProductListDto"
                AllowPaging="true"
                AllowSorting="true"
                AllowFiltering="true"
                AllowExcelExport="true"
                AllowPdfExport=true
                AllowReordering="true"
                RowHeight="35"
                Toolbar="@(new List<string>() { "Search", "ExcelExport","PdfExport"})"
                ContextMenuItems="@(new List<object>() { "AutoFit", "AutoFitAll", "SortAscending", "SortDescending","Copy", "ExcelExport", "CsvExport"})">
      @*   DataSource="@ProductList"
        Load="OnLoad"> *@

    @* <GridEditSettings AllowAdding="false" AllowEditing="false" AllowDeleting="fal" Mode="EditMode.Dialog"></GridEditSettings> *@

            <SfDataManager HttpClientInstance="@httpClient" Url="/api/products/getproducts" Adaptor="Adaptors.WebApiAdaptor"></SfDataManager>

            <GridEvents OnToolbarClick="ToolbarClickHandler" TValue="ProductListDto"></GridEvents>

            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
            <GridPageSettings PageSize="10" PageSizes="@(new List<object>() {10, 20, 50,100})"></GridPageSettings>

            <GridColumns>
                <GridColumn Field="@nameof(ProductListDto.Id)" HeaderText="ID" IsPrimaryKey="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" Width="80" />
                <GridColumn Field="@nameof(ProductListDto.Code)" HeaderText="Code" Width="120" />
                <GridColumn Field="@nameof(ProductListDto.Description)" HeaderText="Description" Width="200" />
                <GridColumn Field="@nameof(ProductListDto.PrimaryUnitSymbol)" HeaderText="Unit" Width="100" />
            </GridColumns>
        </SfGrid>
    </div>
</div>
<style>
    .e-grid .e-headercelldiv {
        font-size: 15px;
        font-weight: bold;
        color: #3c3c3c;
    }

    .e-grid .e-rowcell {
        font-size: 14px;
        padding: 8px;
    }

    .e-grid .e-gridheader {
        background-color: #f8f9fa;
    }

    .e-button {
        font-size: 14px;
    }

    .e-icon-btn {
        padding: 6px 14px;
        display: flex;
        align-items: center;
    }

    .ml-2 {
        margin-left: 8px;
    }
</style>

@code {
    SfGrid<ProductListDto>? DefaultGrid;
    private HttpClient? httpClient;
    // private List<ProductListDto> ProductList = new();
    private int? SelectedProductId;

    protected override void OnInitialized()
    {
        httpClient = HttpClientFactory.CreateClient("Auth");
        base.OnInitialized();
    }


    private void Add()
    {
        NavigationManager.NavigateTo("product/create");
    }

    private void Update()
    {
        var selectedProduct = DefaultGrid?.SelectedRecords.FirstOrDefault();
        if (selectedProduct != null)
        {
            NavigationManager.NavigateTo($"product/update/{selectedProduct.Id}");
        }
        else
        {
            JSRuntime.InvokeVoidAsync("alert", "Please select a product to update.");
        }
    }
    private async Task ExportToExcel()
    {
        await DefaultGrid!.ExportToExcelAsync();
    }


}
