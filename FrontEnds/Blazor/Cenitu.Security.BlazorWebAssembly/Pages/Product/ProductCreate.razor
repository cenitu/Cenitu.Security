@page "/product/create"

@inject IHttpClientFactory HttpClientFactory
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin")]

<h3 class="text-center mt-4 text-primary">Create New Product</h3>

<div class="container mt-4">
    <div class="card shadow-lg p-4">
        <div class="row">
            <div class="col-md-6">
                @* <label class="form-label" for="Code">Product Code</label> *@
   @*              <input type="text" class="form-control" @bind="product.Code" autofocus required id="Code" name="codeInput" placeholder="Enter Product Code" /> *@

                <SfTextBox @bind-value="product.Code" autofocus FloatLabelType="Syncfusion.Blazor.Inputs.FloatLabelType.Auto" placeholder="Enter Product Code" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="Description">Product Description</label>
                <input type="text" class="form-control" @bind="product.Description" required id="Description" name="descriptionInput" placeholder="Enter Product Description" />
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-md-6">
                <label class="form-label">Product Type</label>
                <select class="form-control" @bind="product.ProductType">
                    <option value="">-- Select a Product Type --</option>
                    @foreach (var type in productTypes)
                    {
                        <option value="@type.Value">@type.Text</option>
                    }
                </select>
            </div>
        </div>
        <hr class="my-4" />

        <h4 class="text-center text-secondary">Product Units</h4>
        <div class="row">
            <div class="col-md-5">
                <label class="form-label">Select Unit</label>
                <select class="form-control" @bind="selectedUnitId">
                    <option value="">-- Select a Unit --</option>
                    @foreach (var unit in availableUnits)
                    {
                        <option value="@unit.Id">@unit.Symbol</option>
                    }
                </select>
              @*   <SfDropDownList TValue="int?" TItem="UnitDto" @bind-Value="@selectedUnitId" DataSource="@availableUnits">
                    <DropDownListFieldSettings Value="Symbol"></DropDownListFieldSettings>
                </SfDropDownList> *@
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-success w-100" @onclick="AddUnit">Add Unit</button>
            </div>
        </div>

        @if (product.ProductUnits.Any())
        {
            <table class="table table-hover table-bordered mt-4 text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Primary</th>
                        <th>Unit</th>
                        <th>Conversion Factor</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var unit in product.ProductUnits)
                    {
                        <tr>
                            <td>
                                <input type="radio" name="primaryUnit" checked="@unit.IsPrimary" @onclick="() => SetPrimaryUnit(unit)" />
                            </td>
                            <td>1 @unit.UnitSymbol</td>
                            <td>
                                <input type="number" class="form-control w-50 mx-auto" @bind="unit.ConversionFactor" min="0.0001" step="0.0001" /> @product.ProductUnits.Where(pu => pu.IsPrimary).FirstOrDefault()!.UnitSymbol)
                            </td>
                            <td>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveUnit(unit)">❌ Remove</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="d-flex justify-content-between mt-4">
            <a class="btn btn-outline-secondary" href="products">⬅ Back</a>
            <button class="btn btn-primary px-4" @onclick="AddProductAsync">✅ Create Product</button>
        </div>
    </div>
</div>

@code {
    private ProductCreateDto product = new ProductCreateDto();
    private List<UnitDto> availableUnits = new();
    private List<UnitDto> allUnits = new();
    private int? selectedUnitId;
    private List<(ProductType Value, string Text)> productTypes = new();

    protected override async Task OnInitializedAsync()
    {
        HttpClient = HttpClientFactory.CreateClient("Auth");
        allUnits = (await HttpClient.GetFromJsonAsync<List<UnitDto>>("units")) ?? [];

        availableUnits = new List<UnitDto>(allUnits);

        // Enum değerlerini listeye çevir
        productTypes = Enum.GetValues<ProductType>()
                           .Select(e => (e, e.GetDisplayName())) // Eğer Display Name eklemek istersen burayı güncelle
                           .ToList();
    }

    private void AddUnit()
    {
        if (selectedUnitId == null || selectedUnitId == 0)
            return;

        var selectedUnit = availableUnits.FirstOrDefault(u => u.Id == selectedUnitId);
        if (selectedUnit == null)
            return;

        if (product.ProductUnits.Any(pu => pu.UnitId == selectedUnit.Id))
            return;

        bool isPrimary = product.ProductUnits.Count == 0;

        if (isPrimary)
        {
            foreach (var unit in product.ProductUnits)
            {
                unit.IsPrimary = false;
            }
        }

        product.ProductUnits.Add(new ProductUnitDto
            {
                UnitId = selectedUnit.Id,
                UnitSymbol = selectedUnit.Symbol,
                ConversionFactor = 1.0M,
                IsPrimary = isPrimary
            });

        availableUnits.Remove(selectedUnit);
        selectedUnitId = null;
    }

    private void RemoveUnit(ProductUnitDto unit)
    {
        product.ProductUnits.Remove(unit);

        var unitToReAdd = allUnits.FirstOrDefault(u => u.Id == unit.UnitId);
        if (unitToReAdd != null)
        {
            availableUnits.Add(unitToReAdd);
        }

        if (unit.IsPrimary && product.ProductUnits.Count > 0)
        {
            product.ProductUnits[0].IsPrimary = true;
        }
    }

    private void SetPrimaryUnit(ProductUnitDto selectedUnit)
    {
        foreach (var unit in product.ProductUnits)
        {
            unit.IsPrimary = (unit.UnitId == selectedUnit.UnitId);
        }
    }

    public async Task AddProductAsync()
    {
        if (!product.ProductUnits.Any(u => u.IsPrimary) && product.ProductUnits.Count > 0)
        {
            product.ProductUnits[0].IsPrimary = true;
        }
     
        await HttpClient.PostAsJsonAsync("Products", product);
        NavigationManager.NavigateTo("products");
    }
}
